{
	"name": "versatiles-fonts",
	"version": "0.0.0",
	"private": true,
	"description": "Free font glyphs tailored for map rendering.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "node scripts/build.ts",
		"update-fonts": "node scripts/update-fonts.ts",
		"glyph-diff": "node scripts/glyph-diff.ts",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run format:check",
		"upgrade": "ncu -u --peer && rm -rf node_modules package-lock.json && npm install"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"fontkit": "^2.0.4",
		"subset-font": "^2.7.0"
	},
	"devDependencies": {
		"@types/fontkit": "^2.0.9",
		"@types/node": "^26.5.1",
		"npm-check-updates": "^23.1.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	}
}
